{
  "manifest_version": 3,
  "name": "Task Tabs",
  "version": "1.5",
  "description": "Groups browser tabs by Jira task, driven from the command line.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "tabGroups", "alarms", "storage"],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "sync.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["qa/boot.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["qa/*.js", "lib/qa-cases.js", "lib/qa-pending.js", "lib/task-key.js", "lib/draggable.js"],
      "matches": ["http://localhost/*", "http://127.0.0.1/*"]
    }
  ]
}
